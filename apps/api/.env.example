# The API reads the repository root .env, the same file the ingest scripts use.
DATABASE_URL=postgres://bakumon:bakumon@localhost:55432/bakumon
PORT=3001
# Comma-separated browser origins. Empty means no browser origin is allowed - CORS fails
# closed, so this must be set to the real site origin before the frontend is deployed.
CORS_ORIGINS=http://localhost:5173
