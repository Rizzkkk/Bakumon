# Read at BUILD time and baked into the bundle, so changing it needs a rebuild, not a restart.
VITE_API_BASE_URL=http://localhost:3001

# The site's own origin, no trailing slash. Read by lib/site.js. Everything origin-dependent
# - <link rel="canonical">, every absolute URL in the JSON-LD - renders nothing when this is
# unset, which is correct for a local dev build and wrong for production. scripts/make-
# sitemap.js reads SITE_URL (not VITE_-prefixed) from the environment and refuses to run
# without it.
VITE_SITE_URL=https://bakumon.net
