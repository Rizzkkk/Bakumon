# apps/api/src/config.js reads THIS file, at the repository root - not apps/api/.env.
# All three are required. An empty CORS_ORIGINS fails closed and blocks every browser
# request, which is the intended behaviour but looks like a mystery CORS bug on deploy day.
DATABASE_URL=postgres://bakumon:bakumon@localhost:55432/bakumon
PORT=3001

# Comma-separated, exact origins. The Vite dev server is http://localhost:5173. The
# production origin is https://bakumon.net, and it is appended rather than substituted -
# replacing the whole line is how the dev origin gets silently dropped.
CORS_ORIGINS=http://localhost:5173,https://bakumon.net
